<%#
# Edit

This view is the template for the edit page.

It displays a header, and renders the `_form` partial to do the heavy lifting.

## Local variables:

- `page`:
  An instance of [Administrate::Page::Form][1].
  Contains helper methods to help display a form,
  and knows which attributes should be displayed in the resource's form.

[1]: http://www.rubydoc.info/gems/administrate/Administrate/Page/Form
%>

<% content_for(:title) do %>
  <%= display_resource_name('Service') %>
<% end %>

<% content_for(:head) do %>
  <script src="https://unpkg.com/alpinejs" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/marked@2.1.3/marked.min.js"></script>
<% end %>

<header class="main-content__header" role="banner">
  <h1 class="main-content__page-title" id="page-title">
    <%= @service.service_name %>
  </h1>
  <h2>Service ID: <%= @service.service_id %></h2>
</header>

<section class="main-content__body">

  <%= form_with(model: @maintenance_mode_settings,
               url: admin_service_path(@service.service_id),
               method: :put) do |f| %>

    <div class="form-actions">
      <%= link_to 'Back to services', admin_services_path, class: "button" %>
      <%= f.submit 'Save', class: 'button' %>
    </div>

    <% if @maintenance_mode_settings.errors.any? %>
      <div class="flashes">
        <div class="flash flash-error">
          <ul>
            <% @maintenance_mode_settings.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    <% end %>

    <fieldset class="field-unit">
      <legend>Maintenance mode</legend>
      <div class="field-unit__field">
        <label>
          <%= f.radio_button :maintenance_mode, 1,
            checked: @maintenance_mode_settings.maintenance_mode == '1' %>
          Enabled
        </label>
        <label>
          <%= f.radio_button :maintenance_mode, 0,
            checked: @maintenance_mode_settings.maintenance_mode != '1' %>
          Disabled
        </label>
      </div>
    </fieldset>

    <div class="field-unit">
      <div class="field-unit__label">
        <%= f.label :maintenance_page_heading %>
      </div>
      <div class="field-unit__field">
        <%= f.text_field :maintenance_page_heading %>
      </div>
    </div>

    <div class="field-unit">
      <div class="field-unit__label">
        <%= f.label :maintenance_page_content %>
      </div>
      <div class="field-unit__field">
        <p class="field-unit__hint">Content should be formatted as markdown. N.B. For a single line break, the line must end in a double space</p>
        <div class="fb-admin-markdown-editor">
          <%= f.text_area :maintenance_page_content, rows: 15 %>
        </div>
      </div>
    </div>
  <% end %>
</section>
