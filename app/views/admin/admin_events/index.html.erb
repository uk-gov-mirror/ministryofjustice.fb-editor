<% content_for(:title) do %>
  <%= display_resource_name('AdminEvent') %>
<% end %>

<header class="main-content__header" role="banner">
  <h1 class="main-content__page-title" id="page-title">
    <%= content_for(:title) %>
    - <%= @admin_events.count < @admin_events.limit_value ? @admin_events.count : @admin_events.limit_value %>
    of <%= @admin_events.total_count %>
  </h1>
</header>

<section class="main-content__body main-content__body--flush">
  <% if @admin_events.empty? %>
    <p>No admin actions have been recorded yet.</p>
  <% else %>
    <table aria-labelledby="page-title">
      <thead>
        <tr>
          <th scope="col" class="cell-label">When</th>
          <th scope="col" class="cell-label">Who</th>
          <th scope="col" class="cell-label">Service</th>
          <th scope="col" class="cell-label">Action</th>
        </tr>
      </thead>
      <tbody>
        <% @admin_events.each do |admin_event| %>
          <tr class="js-table-row">
            <td class="cell-data">
              <%= admin_event.created_at&.strftime('%d %b %Y %H:%M') %>
            </td>
            <td class="cell-data">
              <% if admin_event.user_id.nil? %>
                Non-UI action (console or task)
              <% else %>
                <%= admin_event.user&.email || 'Unknown user (account removed)' %>
              <% end %>
            </td>
            <td class="cell-data">
              <%= @service_names[admin_event.service_id].presence || admin_event.service_id || '—' %>
            </td>
            <td class="cell-data"><%= admin_event.action %></td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <%= paginate @admin_events %>
  <% end %>
</section>
