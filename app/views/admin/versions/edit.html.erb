<% content_for(:title) do %>
  <%= display_resource_name('Service') %>
<% end %>

<header class="main-content__header" role="banner">
  <h1 class="main-content__page-title" id="page-title">
    <%= @version.name %>
  </h1>

  <h2>Version ID: <%= @version.id %></h2>
</header>

<section class="main-content__body main-content__body">
  <div>
    <%= link_to 'Back to service', admin_service_path(@service_id), class: "button" %>

    <fieldset class="model-info">
      <dt class="attribute-label" id="created-by">Created by</dt>
      <dd class="attribute-data attribute-data--string"><%= @version_creator.name %></dd>

      <dt class="attribute-label" id="created-at">Created at</dt>
      <dd class="attribute-data attribute-data--date-time"><%= l(@version.metadata['created_at'].to_time) %></dd>
    </fieldset>

    <%= form_with(
        url: admin_service_version_path(@service_id, @version.version_id),
        method: :put,
        local: true) do |f| %>
      <%= f.submit 'Save', class: 'button', id: 'version-save' %>
      <div class="field-unit">
        <div class="field-unit__field">
          <textarea id="version" name="version" rows="100" aria-describedby="version-hint">
            <%= JSON.pretty_generate(@version.metadata) %>
          </textarea>
        </div>
      </div>
    <% end %>
  </div>
</section>
