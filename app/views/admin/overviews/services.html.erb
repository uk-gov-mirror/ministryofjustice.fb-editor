<% content_for(:title) do %>
  <%= display_resource_name('Overview') %>
<% end %>

<header class="main-content__header" role="banner">
  <h1 class="main-content__page-title" id="page-title">
    <%= content_for(:title) %>
  </h1>
</header>

<section class="main-content__body">
  <fieldset class="">
    <% @stats.each do |stat| %>
      <dt class="attribute-label" id="<%= stat[:name].to_s.parameterize %>"><%= stat[:name] %></dt>
      <dd class="attribute-data attribute-data--string"><%= stat[:value] %></dd>
    <% end %>
  </fieldset>
</section>
