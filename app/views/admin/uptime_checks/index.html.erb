<% content_for(:title) do %>
  <%= display_resource_name('UptimeChecks') %>
<% end %>

<header class="main-content__header" role="banner">
  <h1 class="main-content__page-title" id="page-title">
    <%= content_for(:title) %>
  </h1>
</header>

<% if HostEnv.live? %>
  <section class="main-content__body main-content__body">
    <h2>
      Without Checks
    </h2>

    <table aria-labelledby="page-title">
      <thead>
        <tr>
          <th scope="col" class="cell-label">Service Name</th>
          <th scope="col" class="cell-label">Service ID</th>
          <th scope="col" class="cell-label">Service Slug</th>
          <th scope="col" class="cell-label"></th>
        </tr>
      </thead>
      <tbody>
        <% @without_checks.each do |service| %>
          <tr>
            <td class="cell-data"  id="service-name">
              <%= service.service_name %>
            </td>
            <td class="cell-data"  id="service-id">
              <%= service.service_id %>
            </td>
            <td class="cell-data"  id="service-slug">
              <%= service_slug(service) %>
            </td>
            <td class="cell-data">
              <%= form_with url: admin_uptime_checks_path,
                  method: :post do |form| %>
                  <%= form.hidden_field(:id, value: service.service_id) %>
                  <%= form.submit('Create', class: 'button') %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <h2>
      With Checks
    </h2>

    <table aria-labelledby="page-title">
      <thead>
        <tr>
          <th scope="col" class="cell-label">Service Name</th>
          <th scope="col" class="cell-label">Hostname</th>
          <th scope="col" class="cell-label">Check ID</th>
          <th scope="col" class="cell-label">Status</th>
          <th scope="col" class="cell-label"></th>
        </tr>
      </thead>
      <tbody>
        <% @with_uptime_checks.each do |check| %>
          <tr>
            <td class="cell-data" id="service-name">
              <%= check['name'].gsub('Form Builder - ', '') %>
            </td>
            <td class="cell-data" id="hostname">
              <%= check['hostname'] %>
            </td>
            <td class="cell-data" id="check-id">
              <%= check['id'] %>
            </td>
            <td class="cell-data" id="check-status">
              <%= check['status'] %>
            </td>
            <td class="cell-data">
              <%= form_with url: admin_uptime_check_path(check['id']),
                  method: :delete do |form| %>
                  <%= form.submit('Delete', class: 'button button--danger') %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <h2>
      Other MoJ Forms Uptime Checks
    </h2>

    <table aria-labelledby="page-title">
      <caption>
        These checks were created outside the editor admin dashboard
      </caption>
      <thead>
        <tr>
          <th scope="col" class="cell-label">Service Name</th>
          <th scope="col" class="cell-label">Hostname</th>
          <th scope="col" class="cell-label">Check ID</th>
          <th scope="col" class="cell-label">Status</th>
        </tr>
      </thead>
      <tbody>
        <% @non_editor_checks.each do |check| %>
          <tr>
            <td class="cell-data" id="service-name">
              <%= check['name'].gsub('Form Builder - ', '') %>
            </td>
            <td class="cell-data" id="hostname">
              <%= check['hostname'] %>
            </td>
            <td class="cell-data" id="check-id">
              <%= check['id'] %>
            </td>
            <td class="cell-data" id="check-status">
              <%= check['status'] %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
<% else %>
  <h2>
    This is only available in the Live environment
  </h2>
<% end %>
