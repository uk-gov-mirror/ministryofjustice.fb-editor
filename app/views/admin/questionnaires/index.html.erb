<% content_for(:title) do %>
  <%= display_resource_name('Questionnaires') %>
<% end %>

<header class="main-content__header" role="banner">
  <h1 class="main-content__page-title" id="page-title">
    <%= content_for(:title) %>
    - <%= @questionnaires.count < @questionnaires.limit_value ? @questionnaires.count : @questionnaires.limit_value %>
    of <%= @questionnaires.total_count %>
  </h1>
</header>

<section class="main-content__body main-content__body">
  <table aria-labelledby="page-title">
    <thead>
      <tr>
        <th scope="col"  class="cell-label">New form reason</th>
        <th scope="col"  class="cell-label">GOVUK forms ruled out</th>
        <th scope="col"  class="cell-label">Required MOJ forms features</th>
        <th scope="col"  class="cell-label">GOVUK forms ruled out reason</th>
        <th scope="col"  class="cell-label">Continue with MOJ forms</th>
        <th scope="col"  class="cell-label">Estimated page count</th>
        <th scope="col"  class="cell-label">Estimated first year submissions count</th>
        <th scope="col"  class="cell-label">Submission delivery method</th>
        <th scope="col"  class="cell-label">Created at</th>
        <th scope="col"  class="cell-label">Service</th>
      </tr>
    </thead>
    <tbody>
      <% @questionnaires.each do |questionnaire| %>
        <tr>
          <td class="cell-data">
            <%= I18n.t("activemodel.attributes.questionnaire/get_started_form/new_form_reason.#{questionnaire.new_form_reason}") %>
          </td>
          <td class="cell-data">
            <%= I18n.t("activemodel.attributes.questionnaire/gov_forms/govuk_forms_ruled_out.#{questionnaire.govuk_forms_ruled_out}") unless questionnaire.govuk_forms_ruled_out.nil? %>
          </td>
          <td class="cell-data">
            <% questionnaire.required_moj_forms_features.to_a.each do |f| %>
              <p><%=I18n.t("activemodel.attributes.questionnaire/form_features_form/required_moj_forms_features.#{f}") %></p>
            <% end %>
          </td>
          <td class="cell-data">
            <%= questionnaire.govuk_forms_ruled_out_reason %>
          </td>
          <td class="cell-data">
            <%= I18n.t("activemodel.attributes.questionnaire/continue_form/continue_with_moj_forms.#{questionnaire.continue_with_moj_forms}") unless questionnaire.continue_with_moj_forms.nil? %>
          </td>
          <% %w[estimated_page_count estimated_first_year_submissions_count submission_delivery_method].each do |s|%>
          <td class="cell-data">
            <%= I18n.t("activemodel.attributes.questionnaire/new_form_form/#{s}.#{questionnaire.send(s)}") if questionnaire.send(s) %>
          </td>
          <% end %>
          <td class="cell-data">
            <%= Time.parse questionnaire.created_at %>
          </td>
          <td class="cell-data">
            <%= link_to service_name_for(questionnaire.service_id), admin_service_path(questionnaire.service_id) %>
            <br>
            <span class="cell-data--muted"><%= questionnaire.service_id[0..7] %></span>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%= paginate @questionnaires, param_name: 'page' %>
</section>
