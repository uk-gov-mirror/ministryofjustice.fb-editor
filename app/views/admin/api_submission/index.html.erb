<header class="main-content__header" role="banner">
  <h1 class="main-content__page-title" id="page-title">
    <%= 'Index API Submission Settings' %>
  </h1>
</header>

<section class="main-content__body main-content__body">
  <% unless flash.empty? %>
    <div class="flashes">
      <% flash.each do |key, value| %>
        <div class="flash flash-<%= key %>">
          <%= value %>
        </div>
      <% end %>
    </div>
  <% end %>

  <%= link_to 'Back to the service administration page', admin_service_path(params[:service_id]), class: "button" %>

  <% content_for :forms do %>
    <%= render 'form', object: @api_submission_settings_dev, deployment_environment: 'dev' %>
    <%= render 'form', object: @api_submission_settings_production, deployment_environment: 'production' %>
  <% end %>
  <%= yield :forms %>
</section>
