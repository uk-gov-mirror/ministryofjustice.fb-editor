<%#
# Application Layout

This view template is used as the layout
for every page that Administrate generates.

By default, it renders:
- Navigation
- Content for a search bar
  (if provided by a `content_for` block in a nested page)
- Flashes
- Links to stylesheets and JavaScripts
%>

<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <meta name="ROBOTS" content="NOODP">
    <meta name="viewport" content="initial-scale=1">
    <meta name="turbo-prefetch" content="false">
    <%#
      Administrate 1.0 bundles a css-anchor-positioning polyfill that runs
      unconditionally on load, fetching and blob-rewriting every stylesheet on
      the page. Modern browsers support anchor positioning natively, so the
      polyfill is wasted work that snowballs into a blob-request storm on Turbo
      navigations. Passing an empty `elements` array makes it scan nothing.
    %>
    <%= javascript_tag nonce: true do %>
      window.ANCHOR_POSITIONING_POLYFILL_OPTIONS = { elements: [] };
    <% end %>
    <title>
      <%= content_for(:title) %> - MoJ Forms Editor
    </title>
    <%= render "stylesheet" %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag if defined?(csp_meta_tag) %>
    <%= yield :head %>
  </head>
  <body>
    <%= render "icons" %>

    <div class="app-container">
      <%= render "navigation" -%>

      <main class="main-content" role="main">
        <%= render "flashes" -%>
        <%= yield %>
      </main>
    </div>

    <%= render "javascript" %>
  </body>
</html>
